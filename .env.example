# Copy to .env.local and fill in. Every VITE_* value is embedded in the public
# client bundle — never put secrets or API keys here.

# HTTPS endpoint that accepts POST application/json:
#   { name, email, projectType, message }
# and returns 2xx on success. Leave empty to keep the form in "not connected" mode.
VITE_CONTACT_ENDPOINT=

# Optional public address shown as a mailto fallback when no endpoint is configured.
VITE_CONTACT_EMAIL=

# Production origin, used for canonical / Open Graph URLs (no trailing slash).
VITE_SITE_URL=
